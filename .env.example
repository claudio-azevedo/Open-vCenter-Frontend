# Copy to .env.local for local development.

# --- API (browser) ---------------------------------------------------------
# Base URL the browser uses. It hits the frontend's own proxy at
# /frontend-api/api, which attaches the OIDC bearer token server-side.
#   - Single domain behind a proxy: leave unset (defaults to /frontend-api/api)
#   - Split-origin local dev (vite on :3000): the absolute origin below
VITE_API_URL=http://localhost:3000/frontend-api/api

# Optional: name shown on the login button ("Sign in with <name>").
# VITE_OIDC_PROVIDER_NAME=Keycloak

# Guacamole console tunnel. The browser calls /webrdp/tunnel on this app
# (always same-origin); src/routes/webrdp/tunnel.ts speaks the Guacamole
# protocol to guacd itself - no ovc-webrdp service. VITE_WEBRDP_URL only
# changes the path prefix; leave it at the default.
# VITE_WEBRDP_URL=/webrdp

# --- Server-only (never sent to the browser) -------------------------------
# Base URL of ovc-backend's REST API, used by the /frontend-api/api proxy.
API_URL=http://localhost:8000/api

# guacd for the console tunnel (read per connection): host:port, or a URL like
# tcp://host:port / http://host:port - the scheme is ignored (guacd is raw TCP).
# No port => 4822. Default: localhost:4822.
GUACD_URL=localhost:4822

# OIDC. Any OpenID Connect provider with a discovery document works
# (Keycloak, Auth0, Okta, Entra ID, Google, …). Dedicated to this deployment.
# Local default = infra-containers Keycloak, realm "ovc" (admin console admin/admin).
OIDC_ISSUER=http://localhost:8080/realms/ovc
OIDC_CLIENT_ID=ovc-frontend
OIDC_CLIENT_SECRET=ovc-frontend-dev-secret
# OIDC_SCOPES=openid profile email
# Where roles live in the token. "${client_id}" is substituted.
#   Keycloak client roles (default): resource_access.${client_id}.roles
#   Keycloak realm roles           : realm_access.roles
#   Auth0 / Okta / flat claim      : roles   (or "https://ovc.example/roles")
# OIDC_ROLES_CLAIM=resource_access.${client_id}.roles

# better-auth (cookie sessions, no database).
#   BETTER_AUTH_SECRET: generate with `openssl rand -hex 32`
BETTER_AUTH_SECRET=change-me-32-bytes-hex
BETTER_AUTH_URL=http://localhost:3000/frontend-api/auth

# --- No-auth bypass ---------------------------------------------------------
# Skip OIDC entirely: every request is admin@ovc.debug.app (ADMINISTRATOR),
# no login screen. Works in every build, including production - the UI shows
# a standing warning dialog while it's active. Same variable, same value as
# ovc-backend's OVC_AUTH_MODE - set both to "stub" and neither side needs an
# IdP (the proxy forwards requests without a token).
# OVC_AUTH_MODE=stub

# --- Demo mode ---------------------------------------------------------------
# Standalone product demo: no ovc-backend, agent, RabbitMQ, DB, OIDC or
# guacd - the browser simulates the backend and keeps a random inventory in
# localStorage; the login screen opens a demo session with no IdP (everyone is
# demo@ovc.demo, ADMINISTRATOR). When set,
# none of the variables above is needed. See README "Demo mode".
# OVC_DEMO_MODE=true
