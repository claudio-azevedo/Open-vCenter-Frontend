# Força o registry público apenas neste projeto, ignorando o registry
# privado configurado no ~/.npmrc do usuário.
registry=https://registry.npmjs.org/

# `npm version <patch|minor|major>` (see README "Releasing"): tags without a
# "v" prefix (0.1.2, matching the existing tags and the CI's "*.*.*" trigger)
# and commits as "Release 0.1.2".
tag-version-prefix=""
message="Release %s"
